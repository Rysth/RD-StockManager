<div style="max-width: 640px; margin: 0 auto; font-family: Arial, sans-serif; color: #0f172a;">
  <div style="border-radius: 18px; background: linear-gradient(135deg, #0f2742, #1d4ed8); padding: 28px; color: #ffffff;">
    <p style="margin: 0; font-size: 13px; opacity: .8;">Factura electronica autorizada</p>
    <h1 style="margin: 8px 0 0; font-size: 24px;">Gracias por tu compra</h1>
    <p style="margin: 8px 0 0; font-size: 14px; opacity: .85;">
      Adjuntamos el XML autorizado y el RIDE en PDF.
    </p>
  </div>

  <div style="margin-top: 20px; border: 1px solid #e2e8f0; border-radius: 14px; padding: 20px; background: #ffffff;">
    <p style="margin: 0 0 12px; font-size: 16px; font-weight: 700;"><%= @business.name_or_default %></p>
    <table style="width: 100%; border-collapse: collapse; font-size: 14px;">
      <tr>
        <td style="padding: 6px 0; color: #64748b;">Comprobante</td>
        <td style="padding: 6px 0; text-align: right; font-weight: 600;"><%= @invoice.numero_comprobante %></td>
      </tr>
      <tr>
        <td style="padding: 6px 0; color: #64748b;">Autorizacion</td>
        <td style="padding: 6px 0; text-align: right; font-weight: 600;"><%= @invoice.numero_autorizacion %></td>
      </tr>
      <tr>
        <td style="padding: 6px 0; color: #64748b;">Total</td>
        <td style="padding: 6px 0; text-align: right; font-weight: 700;">$<%= format('%.2f', @invoice.importe_total.to_f) %></td>
      </tr>
    </table>
  </div>

  <p style="margin-top: 22px; color: #64748b; font-size: 13px; text-align: center;">
    Powered by <strong>StockManager by RysthDesign</strong>
  </p>
</div>
